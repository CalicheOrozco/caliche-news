# Copia este archivo como .env.local y llena los valores (en Vercel: Settings → Environment Variables)
MONGODB_URI="mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="caliche-news"
# Clave para escribir (POST/PUT/PATCH/DELETE). Genera una larga, p. ej.: openssl rand -hex 32
API_KEY="cambia-esto"
# MCP: clave secreta que va en la URL del conector (https://<dominio>/mcp/<MCP_SECRET>).
# Genera una larga: openssl rand -hex 32
MCP_SECRET="cambia-esto-tambien"
